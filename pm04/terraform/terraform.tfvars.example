# ============================================
# Terraform — terraform.tfvars (EXEMPLO)
# ============================================
# Copie para terraform.tfvars e preencha os valores reais:
#   cp terraform.tfvars.example terraform.tfvars
#
# ATENÇÃO: este arquivo contém SOMENTE placeholders. Nunca versione
# credenciais reais — o terraform.tfvars está no .gitignore.
#
# As credenciais AWS NÃO ficam aqui: use variáveis de ambiente
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY), ~/.aws/credentials ou
# AWS_PROFILE. Nada de chave de acesso no repositório.

# --- AWS ---
aws_region    = "us-east-1"
instance_type = "t3.micro"

# --- Projeto / Ambiente ---
environment   = "dev"
instance_name = "smart-construction"

# --- SSH ---
ssh_public_key_path = "~/.ssh/id_rsa.pub"

# --- Rede (opcional; os padrões já evitam conflito com a infra 10.0.x) ---
vpc_cidr        = "10.10.0.0/16"
app_subnet_cidr = "10.10.1.0/24"
db_subnet_cidr  = "10.10.2.0/24"
