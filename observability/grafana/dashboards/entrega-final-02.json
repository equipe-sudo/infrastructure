{
  "uid": "entrega-final-02",
  "title": "CyberVegas — Observabilidade (Entrega Final 02)",
  "tags": ["equipe-sudo", "entrega-final-02", "observabilidade"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "1. Disponibilidade — validação de conteúdo (últimos 15 min)",
      "description": "Percentual de verificações sintéticas que receberam a resposta esperada da aplicação pelo domínio público. Numerador: increase(httpcheck_validation_passed[15m]). Denominador: passed + failed. O OTel Collector consulta /api/health (espera {\"status\":\"ok\"}) e /api/health/ready (espera {\"status\":\"ready\"}) a cada 30s e valida o JSON.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 95 },
              { "color": "green", "value": 99 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * (sum(increase(httpcheck_validation_passed[15m])) or vector(0)) / clamp_min((sum(increase(httpcheck_validation_passed[15m])) or vector(0)) + (sum(increase(httpcheck_validation_failed[15m])) or vector(0)), 0.000001)",
          "instant": true,
          "legendFormat": "disponibilidade"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "2. Disponibilidade — linha do tempo das verificações",
      "description": "Quantidade de verificações bem-sucedidas, com falha de conteúdo (validação JSON) e com erro de conexão, por intervalo de 5 minutos. Responde 'quando' ocorreu indisponibilidade, enquanto o painel 1 responde 'quanto'.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 18, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 70, "stacking": { "mode": "normal" }, "spanNulls": true, "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "sucesso.*" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": "falha.*" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": "erro.*" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "increase(httpcheck_validation_passed[5m])",
          "legendFormat": "sucesso {{http_url}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "increase(httpcheck_validation_failed[5m])",
          "legendFormat": "falha {{http_url}}"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "increase(httpcheck_error[5m])",
          "legendFormat": "erro conexão {{http_url}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "3. Desempenho — latência por rota (p50 / p95)",
      "description": "Percentis de duração das requisições HTTP do backend, agrupados pela rota normalizada. Origem: histograma app_http_request_duration_seconds (OpenTelemetry, unidade segundos). Agregação: 5 minutos.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "spanNulls": true, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, http_route) (rate(app_http_request_duration_seconds_bucket{service_name=\"equipe-sudo-backend\"}[5m])))",
          "legendFormat": "p95 {{http_route}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le, http_route) (rate(app_http_request_duration_seconds_bucket{service_name=\"equipe-sudo-backend\"}[5m])))",
          "legendFormat": "p50 {{http_route}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "4. Erros — taxa de falhas por rota (4xx / 5xx)",
      "description": "Percentual de requisições com resposta de erro em relação ao total atendido por rota. Numerador: rate(app_http_requests_total{status=~'4..|5..'}). Denominador: rate(app_http_requests_total) da mesma rota. Agregação: 5 minutos.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "spanNulls": true, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * sum by (http_route) (rate(app_http_requests_total{service_name=\"equipe-sudo-backend\", http_response_status_code=~\"5..\"}[5m])) / clamp_min(sum by (http_route) (rate(app_http_requests_total{service_name=\"equipe-sudo-backend\"}[5m])), 0.000001)",
          "legendFormat": "5xx {{http_route}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * sum by (http_route) (rate(app_http_requests_total{service_name=\"equipe-sudo-backend\", http_response_status_code=~\"4..\"}[5m])) / clamp_min(sum by (http_route) (rate(app_http_requests_total{service_name=\"equipe-sudo-backend\"}[5m])), 0.000001)",
          "legendFormat": "4xx {{http_route}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "5. Uso — requisições e operações de negócio",
      "description": "Volume de uso por rota HTTP (excluindo as rotas de health, que são de probe) e por operação de negócio (list/create/toggle/delete). Unidade: requisições por segundo, média em 5 minutos.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "spanNulls": true, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (http_route) (rate(app_http_requests_total{service_name=\"equipe-sudo-backend\", http_route!~\"/health.*\"}[5m]))",
          "legendFormat": "rota {{http_route}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (operation) (rate(app_todos_operations_total{service_name=\"equipe-sudo-backend\"}[5m]))",
          "legendFormat": "op {{operation}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "6. Banco de dados — duração das operações MongoDB (p50 / p95)",
      "description": "Duração das operações do backend com o MongoDB, por operação (find/insert/save/findById/findByIdAndDelete/ping). Origem: histograma app_db_operation_duration_seconds medido no wrapper dbCall do backend. Agregação: 5 minutos.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "spanNulls": true, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(app_db_operation_duration_seconds_bucket{service_name=\"equipe-sudo-backend\"}[5m])))",
          "legendFormat": "p95 {{operation}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le, operation) (rate(app_db_operation_duration_seconds_bucket{service_name=\"equipe-sudo-backend\"}[5m])))",
          "legendFormat": "p50 {{operation}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "7. Banco de dados — falhas nas operações (%)",
      "description": "Percentual de operações de banco que terminaram em falha nos últimos 15 minutos. Numerador: increase(app_db_operations_total{outcome='failure'}). Denominador: todas as operações. Complementa o painel 6, que mostra apenas duração.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 22 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * (sum(increase(app_db_operations_total{service_name=\"equipe-sudo-backend\", outcome=\"failure\"}[15m])) or vector(0)) / clamp_min(sum(increase(app_db_operations_total{service_name=\"equipe-sudo-backend\"}[15m])), 0.000001)",
          "instant": true,
          "legendFormat": "falhas"
        }
      ]
    },
    {
      "id": 8,
      "type": "logs",
      "title": "8. Logs — erros e avisos registrados pelo backend",
      "description": "Logs estruturados (JSON) do backend, coletados via OpenTelemetry e armazenados no Loki. Consulta: registros do serviço equipe-sudo-backend com level=error ou level=warn, exibindo ts, event, request_id, route e status_code.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 22 },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{service_name=\"equipe-sudo-backend\"} | json | level=~`error|warn`",
          "queryType": "range"
        }
      ]
    }
  ]
}
