# ============================================
# Stack de observabilidade — variáveis
# ============================================
# Copie para .env e preencha. NUNCA commitar o .env com valores reais.
#   cp .env.example .env

# --- Grafana ---
# Hostname público do Grafana (túnel dedicado da observabilidade)
GRAFANA_HOST=grafana-equipe-sudo.kolpzs.com
GRAFANA_ADMIN_PASSWORD=troque-esta-senha

# Token do túnel Cloudflare DEDICADO à observabilidade
GRAFANA_TUNNEL_TOKEN=

# --- Probe de disponibilidade (receiver httpcheck) ---
PUBLIC_HEALTH_URL=https://equipe-sudo.kolpzs.com/api/health
PUBLIC_READY_URL=https://equipe-sudo.kolpzs.com/api/health/ready

# --- Ambiente ---
DEPLOYMENT_ENVIRONMENT=dev
