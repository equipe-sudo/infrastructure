# ============================================
# OTel Collector — variáveis de ambiente
# ============================================
# Copie para .env.local e ajuste se necessário.
# O backend da aplicação NÃO usa este arquivo; ele recebe o endpoint OTLP
# pela variável OTEL_EXPORTER_OTLP_ENDPOINT no docker-compose da aplicação.

# Domínio público da aplicação (usado pelo receiver httpcheck)
PUBLIC_HOST=equipe-sudo.kolpzs.com
PUBLIC_HEALTH_URL=https://equipe-sudo.kolpzs.com/api/health
PUBLIC_READY_URL=https://equipe-sudo.kolpzs.com/api/health/ready

DEPLOYMENT_ENVIRONMENT=dev
