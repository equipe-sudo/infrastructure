# ============================================
# Infraestrutura — Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha:
#   cp .env.example .env

# --- OCI (Oracle Cloud Infrastructure) ---
OCI_TENANCY_OCID=
OCI_USER_OCID=
OCI_TENANCY=kolpzs
OCI_REGION=sa-saopaulo-1
OCI_PRIVATE_KEY_PATH=~/.oci/oci_api_key.pem

# --- VM ---
VM_SHAPE=VM.Standard.A1.Flex
VM_OCPUS=2
VM_MEMORY_GB=12

# --- SSH ---
SSH_PUBLIC_KEY_PATH=~/.ssh/id_rsa.pub
SSH_PRIVATE_KEY_PATH=~/.ssh/id_rsa

# --- Object Storage (tfstate) ---
TF_BUCKET_NAME=equipe-sudo-tfstate
TF_OBJECT_PREFIX=terraform/

# --- Tags OCI ---
TAG_PROJECT=equipe-sudo
TAG_ENVIRONMENT=dev
TAG_MANAGED_BY=terraform
