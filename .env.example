# ============================================
# Infraestrutura — Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha:
#   cp .env.example .env

# --- OCI (Oracle Cloud Infrastructure) ---
OCI_TENANCY_OCID=
OCI_USER_OCID=
OCI_TENANCY=kolpzs
OCI_REGION=sa-saopaulo-1
OCI_PRIVATE_KEY_PATH=~/.oci/oci_api_key.pem

# --- VM da aplicação ---
VM_SHAPE=VM.Standard.E2.1.Micro
VM_OCPUS=1
VM_MEMORY_GB=1

# --- VM de observabilidade (Always Free) ---
OBS_VM_SHAPE=VM.Standard.E2.1.Micro
OBS_VM_OCPUS=1
OBS_VM_MEMORY_GB=1

# --- SSH ---
SSH_PUBLIC_KEY_PATH=~/.ssh/id_rsa.pub
SSH_PRIVATE_KEY_PATH=~/.ssh/id_rsa

# --- Object Storage (estado remoto do Terraform) ---
# O backend "oci" está declarado em terraform/main.tf (bucket/key/namespace/region).
# Nada a configurar aqui; as credenciais vêm do perfil OCI (~/.oci/config).

# --- Tags OCI ---
TAG_PROJECT=equipe-sudo
TAG_ENVIRONMENT=dev
TAG_MANAGED_BY=terraform
