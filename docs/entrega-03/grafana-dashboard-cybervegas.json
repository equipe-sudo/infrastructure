{
  "title": "CyberVegas — Aplicação",
  "uid": "cybervegas-app",
  "description": "Somente sinais confirmados do backend OpenTelemetry e do estado Kubernetes.",
  "tags": [
    "cybervegas",
    "tipo-especifico",
    "categoria-observability"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API disponível (/health)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(100 * sum(rate(http_server_duration_milliseconds_count{http_target=\"/health\",http_status_code=\"200\"}[5m])) / clamp_min(sum(rate(http_server_duration_milliseconds_count{http_target=\"/health\"}[5m])),0.000001)) or vector(100)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Sem dados no período",
          "decimals": 2,
          "unit": "percent"
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Banco pronto (/health/ready)",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(100 * sum(rate(http_server_duration_milliseconds_count{http_target=\"/health/ready\",http_status_code=\"200\"}[5m])) / clamp_min(sum(rate(http_server_duration_milliseconds_count{http_target=\"/health/ready\"}[5m])),0.000001)) or vector(100)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Sem dados no período",
          "decimals": 2,
          "unit": "percent"
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Erro HTTP",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(100 * sum(rate(http_server_duration_milliseconds_count{http_status_code=~\"4..|5..\"}[5m])) / clamp_min(sum(rate(http_server_duration_milliseconds_count[5m])),0.000001)) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Sem dados no período",
          "decimals": 2,
          "unit": "percent"
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Exportação OTel / Prometheus",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(up{job=\"otel-collector\"}) * 100",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Sem dados no período",
          "decimals": 2,
          "unit": "percent"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Requests por rota — probes e negócio",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(http_target)(rate(http_server_duration_milliseconds_count[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{http_target}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Sem requisições no período",
          "decimals": 2,
          "unit": "reqps"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latência HTTP p50 / p95",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50,sum by(le,http_target)(rate(http_server_duration_milliseconds_bucket[5m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "p50 {{http_target}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95,sum by(le,http_target)(rate(http_server_duration_milliseconds_bucket[5m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "p95 {{http_target}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Sem amostras no período",
          "decimals": 2,
          "unit": "ms"
        }
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Distribuição de respostas HTTP",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(http_target,http_status_code)(rate(http_server_duration_milliseconds_count[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{http_target}} / {{http_status_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Sem respostas no período",
          "decimals": 2,
          "unit": "reqps"
        }
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Workloads da aplicação",
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_deployment_spec_replicas{namespace=\"default\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{deployment}} desejadas"
        },
        {
          "refId": "B",
          "expr": "kube_deployment_status_replicas_available{namespace=\"default\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{deployment}} disponíveis"
        },
        {
          "refId": "C",
          "expr": "kube_deployment_status_replicas_unavailable{namespace=\"default\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{deployment}} indisponíveis"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Sem workloads",
          "decimals": 2,
          "unit": "short"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Restarts dos Pods da aplicação",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(pod)(increase(kube_pod_container_status_restarts_total{namespace=\"default\",container!=\"\"}[30m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Nenhum restart no período",
          "decimals": 2,
          "unit": "short"
        }
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Targets da observabilidade",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"otel-collector|node-exporter|kube-state-metrics\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Sem targets",
          "decimals": 2,
          "unit": "short"
        }
      }
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": []
}
