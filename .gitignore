# Terraform — não versionar estado local nem binários
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfstate.local.bak
terraform/tfplan*
terraform/terraform.tfvars

# Terraform do Kubernetes (Minikube/ArgoCD)
kubernetes/.terraform/
kubernetes/*.tfstate
kubernetes/*.tfstate.*
kubernetes/tfplan*
kubernetes/terraform.tfvars

# Binários e documentos Office
*.docx
*.pdf

# Variáveis de ambiente locais (nunca versionar secrets)
.env
**/.env

